[user]
	name = Jesse Bellingham
	email = 146690707+jbellingham-eh@users.noreply.github.com
[alias]
	what = show -s --pretty='tformat:%h (%s, %ad)' --date=short

	# show all commits in the past week done by the specified author
	standup = log --since 1.week.ago --author

	# show git log visualised as a branch tree
	tree = log --graph --decorate --oneline
	co = checkout
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[core]
	excludesfile = /Users/jessebellingham/.gitignore_global
	editor = vi
	autocrlf = input
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/jessebellingham/.stCommitMsg
[init]
	defaultBranch = main
