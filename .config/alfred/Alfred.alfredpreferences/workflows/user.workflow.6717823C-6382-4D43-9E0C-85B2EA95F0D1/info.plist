				<integer>102</integer>
				<key>script</key>
				<string>#!/bin/zsh
INBOX="$HOME/second-brain/inbox.local.md"
TIMESTAMP=$(date +"%Y-%m-%d %H:%M")
NOTE="{query}"
# Insert before the first ## section heading (e.g. ## Yesterday's Playback) to
# maintain chronological order in the bullet list. If no heading exists, append.
HEADING_LINE=$(grep -nm1 "^## " "$INBOX" | cut -d: -f1)
if [ -n "$HEADING_LINE" ]; then
    INSERT_AT=$((HEADING_LINE - 1))
    TMP=$(mktemp)
    { head -n "$INSERT_AT" "$INBOX"; printf -- "- %s: %s\n" "$TIMESTAMP" "$NOTE"; tail -n "+$((INSERT_AT + 1))" "$INBOX"; } &gt; "$TMP" &amp;&amp; mv "$TMP" "$INBOX"
else
    printf -- "- %s: %s\n" "$TIMESTAMP" "$NOTE" &gt;&gt; "$INBOX"
fi
echo "Captured: $NOTE"</string>
