# alias rm to trash cli for safer deleting
alias rm="trash"

# safely (moves to trash instead of immediately deleting) recursively delete all node_modules down from the call site -- uses trash cli (brew install trash)
# -F flag asks Finder to do the trashing to allow "put back" feature
alias killnm="find . -name node_modules -type d -prune -exec trash {} +"
alias s="git diff --name-only | sed 's|^app/|spec/|; s|.rb$|_spec.rb|' | xargs -I {} sh -c 'if [ -f "{}" ]; then echo "{}"; fi' | xargs bundle exec rspec"

# remove file from quarantine
alias unquarantine="sudo xattr -rd com.apple.quarantine"

# docker
alias dlist="docker ps -a && docker images"
alias dps="docker ps"
alias dcb="docker-compose build"
alias dcu="docker-compose up"
alias dcd="docker-compose down"
alias dp="docker image prune"
alias dspace="docker system df"
alias dtail="docker logs -f --tail 20"

# kubernetes
alias k="kubectl"
alias kns="kubens"

# dotnet
alias drunp="dotnet run --project"

# laravel
alias sail="sh $([ -f sail ] && echo sail || echo vendor/bin/sail)"

alias cat="bat"
alias top="btop"
# alias vim="lvim -S Session.vim"
alias tmuxa="tmux attach"
alias bu="brew upgrade"
alias dockerdebug="docker run -ti --entrypoint sh"
alias reload='source ~/.zshrc'
alias hgrep="history 1 | grep"
alias grep="rg -iF --color=auto"
alias formatjson="pbpaste | jq . | pbcopy"
alias aliases="alias | less"
alias home="code $HOME"

alias intellij="open -na 'IntelliJ IDEA Ultimate.app'"

alias dotfilesgit="cd ~/ && yadm enter zsh && lazygit"

alias assume="source $(brew --prefix)/bin/assume"

alias dotfilesgit="cd ~/ && yadm enter zsh && lazygit"
alias oms="overmind start"

alias notes="qmd"

# kaydet
alias ktodo='kaydet --search "status:todo" --format json | jq -r --arg cutoff "$(date -v-1m +%Y-%m-%d)" '\''.matches[] | select(.date >= $cutoff) | "\(.date) \(.timestamp) [\(.id)] \(.text)"'\'''
